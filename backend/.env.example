# ── Google Gemini ──────────────────────────────────────────────────────────
# Required: Your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use — gemini-2.0-flash is the recommended default
GEMINI_MODEL=gemini-2.0-flash

# Max tokens in Gemini response (256–65536)
GEMINI_MAX_OUTPUT_TOKENS=8192

# Sampling temperature 0.0 (deterministic) → 1.0 (creative)
# Keep low for code review to minimise hallucinations
GEMINI_TEMPERATURE=0.2

# Timeout in seconds for a single Gemini API call
GEMINI_TIMEOUT_SECONDS=120

# ── GitHub Integration ──────────────────────────────────────────────────────
# GitHub Personal Access Token (PAT) or App Installation Token
# Requires 'repo' and 'pull_requests' scopes
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub REST API Base URL
GITHUB_API_URL=https://api.github.com

# Timeout in seconds for GitHub API HTTP requests
GITHUB_TIMEOUT_SECONDS=30

# ── Chunking ───────────────────────────────────────────────────────────────
# Maximum diff characters before auto-splitting into chunks
MAX_DIFF_CHARS=80000

# Overlap lines between adjacent chunks (preserves context at boundaries)
CHUNK_OVERLAP_LINES=10

# ── Retry policy ───────────────────────────────────────────────────────────
# Maximum retry attempts on transient failures (rate-limit / timeout)
REVIEW_MAX_RETRIES=3

# Base delay in seconds between retries (exponential back-off applied)
REVIEW_RETRY_DELAY=2.0

# ── Application ────────────────────────────────────────────────────────────
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Deployment environment: development | staging | production
ENVIRONMENT=development
