# ============================================================
#  Automated Code Review System — .gitignore
#  Stacks: Python (FastAPI / Uvicorn) · React (Vite / TypeScript)
# ============================================================

# ─── Environment & Secrets ───────────────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example
*.pem
*.key
*.cert

# ─── Python / Backend ────────────────────────────────────────
# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / Optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Distribution / Packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.lcov

# Linting & Type Checking
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Python Tooling
.pdm-python
.pdm-build
pip-log.txt
pip-delete-this-directory.txt

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# ─── Node.js / Frontend ──────────────────────────────────────
# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build Outputs (Vite / Next.js)
frontend/dist/
frontend/build/
.next/
out/
.swc/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lock Files
yarn.lock
pnpm-lock.yaml

# Deployment / Vercel / Turbo
.vercel/
.turbo/

# ─── Database & Local Storage ────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump
dump/
data/

# ─── OS & Editors ────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# IDEs & Code Editors
.vscode/
!.vscode/extensions.json
*.code-workspace
.idea/
*.iml
*.swp
*.swo
Session.vim

# Antigravity IDE & AI Agents Metadata
.gemini/
.agents/

